{
  "name": "loopsmith",
  "version": "0.2.0",
  "description": "Run your issue → implement → review → fix loop across agent CLIs, with a live UI.",
  "scripts": {
    "start": "node bin/loopsmith.js",
    "demo": "node bin/loopsmith.js --demo",
    "dev": "tsx watch server/index.ts --demo & vite",
    "build": "vite build",
    "typecheck": "tsc -p . && tsc -p web",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "express": "^4.22.3",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  },
  "type": "module",
  "private": true,
  "bin": {
    "loopsmith": "bin/loopsmith.js"
  }
}
